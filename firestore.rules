rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function docBelongsToUser(docId) {
      return isSignedIn() && docId.size() >= request.auth.uid.size() && docId[0:request.auth.uid.size()] == request.auth.uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 100;
    }

    function isValidDailyLog(data) {
      return data.uid == request.auth.uid
        && data.date is string && data.date.size() == 10
        && (data.quote == null || (data.quote is string && data.quote.size() <= 500))
        && data.todos is list && data.todos.size() <= 50;
    }

    function isValidFocusGoal(data) {
      return data.uid == request.auth.uid
        && data.name is string && data.name.size() <= 100;
    }

    function isValidFocusLog(data) {
      return data.uid == request.auth.uid
        && data.goalId is string && data.date is string;
    }

    function isValidFinancialLog(data) {
      return data.uid == request.auth.uid
        && data.amount is number && data.category is string;
    }

    function isValidWeeklyHabit(data) {
      return data.uid == request.auth.uid
        && data.name is string && data.name.size() <= 100;
    }

    function isValidHabitCompletion(data) {
      return data.uid == request.auth.uid
        && data.habitId is string && data.weekStart is string;
    }

    function isValidMonthlyGoal(data) {
      return data.uid == request.auth.uid
        && data.title is string && data.title.size() <= 150
        && data.month is string;
    }

    function isValidLongTermPlan(data) {
      return data.uid == request.auth.uid
        && data.title is string && data.title.size() <= 150
        && data.targetDate is string;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().keys().hasAll(['uid', 'name', 'email']);
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == existing().uid;
    }

    match /dailyLogs/{logId} {
      allow read: if docBelongsToUser(logId) || (resource != null && resource.data.uid == request.auth.uid);
      allow create: if docBelongsToUser(logId) && isValidDailyLog(incoming());
      allow update: if docBelongsToUser(logId) && resource.data.uid == request.auth.uid && isValidDailyLog(incoming()) && incoming().uid == existing().uid;
      allow delete: if docBelongsToUser(logId) && resource.data.uid == request.auth.uid;
    }

    match /focusGoals/{goalId} {
      allow read: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isValidFocusGoal(incoming());
      allow update: if resource.data.uid == request.auth.uid && isValidFocusGoal(incoming()) && incoming().uid == existing().uid;
      allow delete: if resource.data.uid == request.auth.uid;
    }

    match /focusLogs/{logId} {
      allow read: if docBelongsToUser(logId) || (resource != null && resource.data.uid == request.auth.uid);
      allow create: if docBelongsToUser(logId) && isValidFocusLog(incoming());
      allow update: if docBelongsToUser(logId) && resource.data.uid == request.auth.uid && isValidFocusLog(incoming()) && incoming().uid == existing().uid;
      allow delete: if docBelongsToUser(logId) && resource.data.uid == request.auth.uid;
    }

    match /bodyArchive/{archiveId} {
      allow read: if resource != null && resource.data.uid == request.auth.uid;
      allow create: if incoming().uid == request.auth.uid;
      allow update: if resource.data.uid == request.auth.uid && incoming().uid == existing().uid;
      allow delete: if resource.data.uid == request.auth.uid;
    }

    match /financialLogs/{logId} {
      allow read: if docBelongsToUser(logId) || (resource != null && resource.data.uid == request.auth.uid);
      allow create: if docBelongsToUser(logId) && isValidFinancialLog(incoming());
      allow update: if docBelongsToUser(logId) && resource.data.uid == request.auth.uid && isValidFinancialLog(incoming()) && incoming().uid == existing().uid;
      allow delete: if docBelongsToUser(logId) && resource.data.uid == request.auth.uid;
    }

    match /weeklyHabits/{habitId} {
      allow read: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isValidWeeklyHabit(incoming());
      allow update: if resource.data.uid == request.auth.uid && isValidWeeklyHabit(incoming()) && incoming().uid == existing().uid;
      allow delete: if resource.data.uid == request.auth.uid;
    }

    match /habitCompletions/{completionId} {
      allow read: if docBelongsToUser(completionId) || (resource != null && resource.data.uid == request.auth.uid);
      allow create: if docBelongsToUser(completionId) && isValidHabitCompletion(incoming());
      allow update: if docBelongsToUser(completionId) && resource.data.uid == request.auth.uid && isValidHabitCompletion(incoming()) && incoming().uid == existing().uid;
      allow delete: if docBelongsToUser(completionId) && resource.data.uid == request.auth.uid;
    }

    match /monthlyGoals/{goalId} {
      allow read: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isValidMonthlyGoal(incoming());
      allow update: if resource.data.uid == request.auth.uid && isValidMonthlyGoal(incoming()) && incoming().uid == existing().uid;
      allow delete: if resource.data.uid == request.auth.uid;
    }

    match /longTermPlans/{planId} {
      allow read: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isValidLongTermPlan(incoming());
      allow update: if resource.data.uid == request.auth.uid && isValidLongTermPlan(incoming()) && incoming().uid == existing().uid;
      allow delete: if resource.data.uid == request.auth.uid;
    }
  }
}
